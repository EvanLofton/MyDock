{
  "name": "dock-app",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "typecheck": "tsc --noEmit",
    "check:magnify": "tsc src/lib/magnify.ts --outDir .tmpcheck --module esnext --target es2022 --moduleResolution bundler --skipLibCheck && node scripts/check-magnify.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "typescript": "^5",
    "vite": "^8"
  }
}
